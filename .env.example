# Server-side only. Copy to .env.local (gitignored). Never commit real values.
APP_BASE_URL=http://localhost:3000

# PayPal — sandbox only; src/env.ts refuses anything else.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Phase 0 proof: the separate recipient sandbox account (business).
PROOF_PAYEE_EMAIL=
PROOF_PAYEE_MERCHANT_ID=

# Later phases
# Neon: `neon env pull` writes these. Pooled for the app, unpooled for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_URL_TEST=
OPENAI_API_KEY=
OPENAI_MODEL=
TRIGGER_SECRET_KEY=
RESEND_API_KEY=
# e.g. "Nonna Mode <notices@your-verified-domain>" (must not look like PayPal)
EMAIL_FROM=
# Optional: send every demo email to this inbox (demo contacts use reserved example.com addresses)
DEMO_EMAIL_OVERRIDE=
# Shown on /demo so judges can approve in PayPal
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
SESSION_SECRET=
SCAN_SECRET=
DEMO_TIME_SCALE=1
